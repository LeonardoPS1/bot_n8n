# ============================================
# Bot Híbrido: Gemini + Claudio (Claude para n8n)
# ============================================

# --------------------------------------------
# Telegram Bot Configuration
# --------------------------------------------
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --------------------------------------------
# Gemini API (Google) - Para chat general
# --------------------------------------------
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------
# Anthropic API (Claude) - Solo para n8n expertise
# --------------------------------------------
# Get your API key from console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --------------------------------------------
# n8n Configuration (para Claudio)
# --------------------------------------------
# Your n8n instance API key
N8N_API_KEY=your_n8n_api_key_here

# Your n8n instance URL
N8N_INSTANCE_URL=http://localhost

# Host header for Traefik routing
N8N_HOST_HEADER=n8n.aicorebots.com

# --------------------------------------------
# Claudio Server Configuration
# --------------------------------------------
# Port for Claudio Server
CLADIO_PORT=8000

# URL for bot to connect to Claudio Server
CLADIO_SERVER_URL=http://localhost:8000

# Request timeout in seconds
REQUEST_TIMEOUT=60

# --------------------------------------------
# Security (Optional)
# --------------------------------------------
# Comma-separated list of allowed Telegram user IDs
# Leave empty to allow everyone
# Get your ID from @userinfobot
ALLOWED_USERS=

# Example: ALLOWED_USERS=123456789,987654321
