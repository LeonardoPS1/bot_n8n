#!/usr/bin/expect -f
set timeout 30
set host "51.222.207.250"
set user "ubuntu"
set password "Cool220479..@"
set pubkey "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMrLxBOtWB03XdZyEfbojiLLV+d+/b+jNi3LMOSVYBN9 claude-bot"

spawn ssh $user@$host
expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$password\r"
        expect "~$"
        send "mkdir -p ~/.ssh && chmod 700 ~/.ssh\r"
        expect "~$"
        send "echo '$pubkey' >> ~/.ssh/authorized_keys\r"
        expect "~$"
        send "chmod 600 ~/.ssh/authorized_keys\r"
        expect "~$"
        send "exit\r"
        expect eof
    }
    timeout {
        puts "Connection timeout"
        exit 1
 }
}
