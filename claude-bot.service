[Unit]
Description=Claude Telegram Bot
After=network.target

[Service]
Type=simple
User=telegrambot
WorkingDirectory=/opt/telegram-claude-bot
Environment="PATH=/opt/telegram-claude-bot/venv/bin"
ExecStart=/opt/telegram-claude-bot/venv/bin/python bot.py
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/claude-bot/bot.log
StandardError=append:/var/log/claude-bot/error.log

[Install]
WantedBy=multi-user.target
