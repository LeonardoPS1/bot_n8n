# ============================================
# Claudio Bot - Configuration File
# ============================================
# Generate your configuration using: python install.py
# Or copy this file to .env and fill in your credentials

# ============================================
# TELEGRAM CONFIG
# ============================================
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ============================================
# AI PROVIDER CONFIG
# ============================================

# Select your AI provider: anthropic, openai, ollama, or multi
AI_PROVIDER=anthropic

# --------------------------------------------
# Option 1: Anthropic (Claude) - Recommended
# --------------------------------------------
# Get your API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Available models:
# - claude-sonnet-4-20250514 (latest, recommended)
# - claude-3-5-sonnet-20241022
# - claude-3-haiku-20240307 (faster, cheaper)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --------------------------------------------
# Option 2: OpenAI
# --------------------------------------------
# Get your API key from platform.openai.com
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Available models:
# - gpt-4o (latest, recommended)
# - gpt-4-turbo
# - gpt-3.5-turbo (cheaper)
# OPENAI_MODEL=gpt-4o

# --------------------------------------------
# Option 3: Ollama (Local & Free)
# --------------------------------------------
# Requires Ollama installed locally
# Download from: ollama.ai
# OLLAMA_BASE_URL=http://localhost:11434

# Available models (after running: ollama pull <model>):
# - llama3 (recommended)
# - llama3:70b (more powerful)
# - mistral
# - codellama
# OLLAMA_MODEL=llama3

# --------------------------------------------
# Option 4: Multiple Providers
# --------------------------------===========
# Configure both Anthropic and OpenAI
# Claudio will use Anthropic as primary, OpenAI as fallback
# AI_PROVIDER=multi
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your-openai-key-here

# ============================================
# N8N CONFIG (Optional)
# ============================================
# Your n8n instance API key (optional)
N8N_API_KEY=your_n8n_api_key_here

# Your n8n instance URL
# Use http://localhost for Traefik routing on same VPS
# Use https://n8n.yourdomain.com for external access
N8N_INSTANCE_URL=https://n8n.yourdomain.com

# Host header for Traefik routing (when using localhost)
# Set this to your n8n domain name
N8N_HOST_HEADER=n8n.yourdomain.com

# ============================================
# SERVER CONFIG
# ============================================
# Port for Claudio Server (default: 8000)
CLADIO_PORT=8000

# URL for bot to connect to Claudio Server
# Use localhost if both run on same machine
CLADIO_SERVER_URL=http://localhost:8000

# Request timeout in seconds (default: 60)
REQUEST_TIMEOUT=60

# ============================================
# SECURITY
# ============================================
# Comma-separated list of allowed Telegram user IDs
# Leave empty or use '*' to allow everyone
# Get your ID from @userinfobot on Telegram
ALLOWED_USERS=

# Example: ALLOWED_USERS=123456789,987654321
# Example: ALLOWED_USERS=* (public access)
