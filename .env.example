# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=tu_token_aqui

# ============================================
# AI API Keys
# ============================================
# Anthropic (Claude) - Primary
ANTHROPIC_API_KEY=tu_api_key_de_anthropic

# OpenAI (GPT-4o) - Fallback 1
OPENAI_API_KEY=tu_api_key_de_openai

# DeepSeek - Fallback 2
DEEPSEEK_API_KEY=tu_api_key_de_deepseek

# GLM / z.ai - Fallback 3
GLM_API_KEY=tu_api_key_de_glm

# ============================================
# n8n Configuration
# ============================================
N8N_API_KEY=tu_n8n_api_key
N8N_INSTANCE_URL=https://n8n.tu-dominio.com
N8N_HOST_HEADER=n8n.tu-dominio.com

# ============================================
# Claudio Server Configuration
# ============================================
CLADIO_PORT=8001
CLADIO_SERVER_URL=http://localhost:8001
REQUEST_TIMEOUT=60

# ============================================
# AI Provider Configuration
# ============================================
# Options: anthropic, openai, gemini, qwen, deepseek, glm, ollama, multi
# Use 'multi' for dynamic switching without restart
AI_PROVIDER=multi
AUTO_FALLBACK=true
FALLBACK_ORDER=anthropic,openai,deepseek,glm

# ============================================
# Permissions
# ============================================
# Comma-separated list of allowed Telegram user IDs
ALLOWED_USERS=tu_id_de_telegram

# Admin users (can use /switch, /status, /addkey, /models, /test)
ALLOWED_ADMIN_USERS=tu_id_de_telegram
