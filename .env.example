# ============================================
# Claudio Bot - Configuration File
# ============================================
# Generate your configuration using: python install.py
# Or copy this file to .env and fill in your credentials

# ============================================
# TELEGRAM CONFIG
# ============================================
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ============================================
# AI PROVIDER CONFIG
# ============================================

# Select your AI provider: anthropic, openai, gemini, qwen, deepseek, ollama, custom, or multi
AI_PROVIDER=anthropic

# --------------------------------------------
# Option 1: Anthropic (Claude) - Recommended
# --------------------------------------------
# Get your API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Available models:
# - claude-sonnet-4-20250514 (latest, recommended)
# - claude-3-5-sonnet-20241022
# - claude-3-haiku-20240307 (faster, cheaper)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --------------------------------------------
# Option 2: OpenAI
# --------------------------------------------
# Get your API key from platform.openai.com
OPENAI_API_KEY=sk-your_openai_api_key_here

# Available models:
# - gpt-4o (latest, recommended)
# - gpt-4-turbo
# - gpt-3.5-turbo (cheaper)
# OPENAI_MODEL=gpt-4o

# --------------------------------------------
# Option 3: Google Gemini
# --------------------------------------------
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Available models:
# - gemini-2.0-flash-exp (latest, fast)
# - gemini-1.5-pro (powerful)
# - gemini-1.5-flash (faster, cheaper)
# GEMINI_MODEL=gemini-2.0-flash-exp

# --------------------------------------------
# Option 4: Alibaba Qwen (Tongyi Qianwen)
# --------------------------------------------
# Get your API key from https://dashscope.aliyuncs.com/
QWEN_API_KEY=your_qwen_api_key_here

# Available models:
# - qwen-plus (recommended)
# - qwen-turbo (faster, cheaper)
# - qwen-max (most powerful)
QWEN_MODEL=qwen-plus
# Base URL for Qwen API (usually no need to change)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --------------------------------------------
# Option 5: DeepSeek
# --------------------------------------------
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Available models:
# - deepseek-chat (recommended)
# - deepseek-coder (specialized for code)
DEEPSEEK_MODEL=deepseek-chat
# Base URL for DeepSeek API (usually no need to change)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --------------------------------------------
# Option 6: Ollama (Local & Free)
# --------------------------------------------
# Requires Ollama installed locally
# Download from: ollama.ai
# OLLAMA_BASE_URL=http://localhost:11434

# Available models (after running: ollama pull <model>):
# - llama3 (recommended)
# - llama3:70b (more powerful)
# - mistral
# - codellama
# OLLAMA_MODEL=llama3

# --------------------------------------------
# Option 7: Custom Model (User-defined)
# --------------------------------------------
# Add your own custom AI model (OpenAI or Anthropic compatible)
CUSTOM_MODEL_NAME=my-custom-model
CUSTOM_MODEL_API_KEY=your_custom_api_key_here
CUSTOM_MODEL_BASE_URL=https://your-custom-api.com/v1
CUSTOM_MODEL_PROVIDER=openai  # or 'anthropic'

# --------------------------------------------
# Option 8: Multiple Providers with Auto-Fallback
# -------------------------------------------
# Configure multiple providers
# Claudio will use them in order: Anthropic → OpenAI → Gemini → Qwen → DeepSeek → Ollama → Custom
# When one runs out of quota or fails, it automatically switches to the next
AI_PROVIDER=multi
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your-openai-key-here
# GEMINI_API_KEY=your_gemini_key_here
# QWEN_API_KEY=your_qwen_key_here
# DEEPSEEK_API_KEY=your_deepseek_key_here
# CUSTOM_MODEL_NAME=your_custom_model
# CUSTOM_MODEL_API_KEY=your_custom_api_key
# CUSTOM_MODEL_BASE_URL=https://your-custom-api.com/v1
# CUSTOM_MODEL_PROVIDER=openai

# ============================================
# FALLBACK CONFIGURATION
# ============================================
# Enable automatic fallback when provider fails (true/false)
AUTO_FALLBACK=true

# Order of providers for fallback (comma-separated)
# Available: anthropic, openai, gemini, qwen, deepseek, ollama
FALLBACK_ORDER=anthropic,openai,gemini,qwen,deepseek,ollama

# ============================================
# N8N CONFIG (Optional)
# ============================================
# Your n8n instance API key (optional)
N8N_API_KEY=your_n8n_api_key_here

# Your n8n instance URL
# Use http://localhost for Traefik routing on same VPS
# Use https://n8n.yourdomain.com for external access
N8N_INSTANCE_URL=https://n8n.yourdomain.com

# Host header for Traefik routing (when using localhost)
# Set this to your n8n domain name
N8N_HOST_HEADER=n8n.yourdomain.com

# ============================================
# SERVER CONFIG
# ============================================
# Port for Claudio Server (default: 8000)
CLADIO_PORT=8000

# URL for bot to connect to Claudio Server
# Use localhost if both run on same machine
CLADIO_SERVER_URL=http://localhost:8000

# Request timeout in seconds (default: 60)
REQUEST_TIMEOUT=60

# ============================================
# ADMIN CONFIGURATION
# ============================================
# Comma-separated list of admin user IDs (can manage models)
# Get your ID from @userinfobot on Telegram
# Leave empty or use '*' for all users to be admins (NOT RECOMMENDED)
ALLOWED_ADMIN_USERS=

# Optional: Additional admin key for security (adds extra layer)
# ADMIN_KEY=your_secret_admin_key_here

# URL for bot notifications (when model switches, errors, etc.)
# This is configured automatically if bot and server are on same machine
# BOT_NOTIFICATION_URL=http://localhost:8000/api/notify

# ============================================
# SECURITY
# ============================================
# Comma-separated list of allowed Telegram user IDs
# Leave empty or use '*' to allow everyone
# Get your ID from @userinfobot on Telegram
ALLOWED_USERS=

# Example: ALLOWED_USERS=123456789,987654321
# Example: ALLOWED_USERS=* (public access)
